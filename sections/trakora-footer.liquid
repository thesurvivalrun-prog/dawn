<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500&family=Inter:wght@400;500&display=swap" rel="stylesheet">

{% style %}
  #shopify-section-{{ section.id }} { --o: #133B46; --cashmere: #F4F0E7; --brass: #B79A6B; --mist: #CFC8B8; }
  .tkf { background: var(--o); color: #E7E2D5; font-family: 'Inter', -apple-system, sans-serif; }
  .tkf .in { max-width: 1140px; margin: 0 auto; padding: 56px 28px 40px; display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 28px; }
  .tkf .brand { max-width: 320px; }
  .tkf .brand .wm { font-family: 'Fraunces', serif; font-weight: 500; font-size: 26px; letter-spacing: .06em; color: #F4EFE3; margin: 0 0 10px; }
  .tkf .brand p { margin: 0; font-size: 14px; color: #AEB7AC; line-height: 1.6; }
  .tkf nav { display: flex; flex-wrap: wrap; gap: 10px 26px; }
  .tkf nav a { color: #D7D2C4; text-decoration: none; font-size: 14px; letter-spacing: .01em; transition: color .3s ease; }
  .tkf nav a:hover { color: var(--brass); }
  .tkf .bar { border-top: 1px solid rgba(207,200,184,.16); }
  .tkf .bar .in2 { max-width: 1140px; margin: 0 auto; padding: 18px 28px; display: flex; flex-wrap: wrap; justify-content: space-between; gap: 12px; font-size: 12.5px; color: #8C968B; letter-spacing: .03em; }
  @media (max-width: 700px) { .tkf .in { flex-direction: column; gap: 24px; } }
{% endstyle %}

<div class="tkf">
  <div class="in">
    <div class="brand">
      <p class="wm">TRAKORA</p>
      <p>{{ 'trakora.footer_tagline' | t }}</p>
    </div>
    <nav aria-label="{{ 'sections.footer.name' | t | default: 'Footer' }}">
      {%- if shop.privacy_policy != blank -%}<a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a>{%- endif -%}
      {%- if shop.refund_policy != blank -%}<a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a>{%- endif -%}
      {%- if shop.terms_of_service != blank -%}<a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title }}</a>{%- endif -%}
      {%- if shop.shipping_policy != blank -%}<a href="{{ shop.shipping_policy.url }}">{{ shop.shipping_policy.title }}</a>{%- endif -%}
      {%- if section.settings.impressum_page != blank -%}<a href="{{ section.settings.impressum_page.url }}">{{ section.settings.impressum_page.title }}</a>{%- endif -%}
      {%- if section.settings.contact_email != blank -%}<a href="mailto:{{ section.settings.contact_email }}">{{ section.settings.contact_label | default: 'Kontakt' }}</a>{%- endif -%}
    </nav>
  </div>
  <div class="bar">
    <div class="in2">
      <span>© {{ 'now' | date: '%Y' }} {{ shop.name }}</span>
      <span>{{ 'trakora.footer_rights' | t }}</span>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "TRAKORA Footer",
  "settings": [
    { "type": "page", "id": "impressum_page", "label": "Impressum-Seite", "info": "Lege im Admin eine Seite 'Impressum' an und wähle sie hier aus." },
    { "type": "text", "id": "contact_email", "label": "Kontakt-E-Mail (optional)" },
    { "type": "text", "id": "contact_label", "label": "Kontakt-Linktext", "default": "Kontakt" }
  ]
}
{% endschema %}
