{%- liquid
  assign product = section.settings.product
  assign variant = product.selected_or_first_available_variant
  assign hero_img = section.settings.hero_image
  assign problem_img = section.settings.problem_image
  assign solution_img = section.settings.solution_image
  assign moment_img = section.settings.moment_image
-%}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">

{% style %}
  #shopify-section-{{ section.id }} { --o: #133B46; --o-2: #0d2c34; --sage: #8C9A86; --sage-d: #5C6B57; --cashmere: #F4F0E7; --sand: #E7DECF; --brass: #B79A6B; --ink: #23292B; --mist: #CFC8B8; }
  .tkx { background: var(--cashmere); color: var(--ink); font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; line-height: 1.7; overflow-x: clip; }
  .tkx * { box-sizing: border-box; }
  .tkx .serif { font-family: 'Fraunces', Georgia, serif; font-weight: 500; letter-spacing: -.01em; }
  .tkx .wrap { max-width: 1140px; margin: 0 auto; padding: 0 28px; }
  .tkx .narrow { max-width: 760px; }
  .tkx .kicker { font-size: 12px; letter-spacing: .28em; text-transform: uppercase; color: var(--brass); font-weight: 600; margin: 0 0 18px; }

  /* Reveal */
  .tkx .rv { opacity: 0; transform: translateY(34px); transition: opacity 1s ease, transform 1s cubic-bezier(.2,.7,.2,1); }
  .tkx .rv.in { opacity: 1; transform: none; }
  .tkx .d1 { transition-delay: .1s; } .tkx .d2 { transition-delay: .2s; } .tkx .d3 { transition-delay: .3s; } .tkx .d4 { transition-delay: .4s; }

  /* Buttons */
  .tkx .btn { position: relative; overflow: hidden; display: inline-block; border: 1px solid var(--brass); background: transparent; color: var(--ink); font-family: 'Inter',sans-serif; font-size: 15px; font-weight: 600; letter-spacing: .02em; padding: 17px 40px; border-radius: 2px; cursor: pointer; text-decoration: none; transition: color .45s ease; }
  .tkx .btn span { position: relative; z-index: 1; }
  .tkx .btn::after { content: ""; position: absolute; inset: 0; background: var(--brass); transform: translateY(101%); transition: transform .5s cubic-bezier(.2,.7,.2,1); z-index: 0; }
  .tkx .btn:hover { color: #fff; }
  .tkx .btn:hover::after { transform: translateY(0); }
  .tkx .btn--ondark { color: #F4F0E7; border-color: var(--brass); }
  .tkx .btn--ondark:hover { color: var(--o); }
  .tkx .btn--ondark:hover::after { background: var(--cashmere); }

  /* HERO */
  .tkx .hero { position: relative; min-height: 92vh; display: flex; align-items: center; justify-content: center; text-align: center; color: #F4F0E7; overflow: hidden; }
  .tkx .hero__bg { position: absolute; inset: 0; z-index: 0; background-size: cover; background-position: center; transform: scale(1.08); animation: tkxKen 18s ease-in-out infinite alternate; }
  @keyframes tkxKen { from { transform: scale(1.08); } to { transform: scale(1.18) translateY(-1.5%); } }
  .tkx .hero__veil { position: absolute; inset: 0; z-index: 1; background: linear-gradient(180deg, rgba(13,44,52,.55) 0%, rgba(13,44,52,.35) 40%, rgba(13,44,52,.7) 100%); }
  .tkx .hero__in { position: relative; z-index: 2; padding: 0 28px; max-width: 820px; }
  .tkx .hero h1 { font-size: clamp(38px, 6.4vw, 78px); line-height: 1.04; margin: 0 0 22px; color: #F8F5EE; }
  .tkx .hero p { font-size: clamp(17px, 2vw, 21px); color: #EAE6DB; opacity: .95; max-width: 560px; margin: 0 auto 34px; font-weight: 400; }
  .tkx .hero .kicker { color: #D9C7A3; }
  .tkx .scroll { margin-top: 46px; font-size: 12px; letter-spacing: .25em; text-transform: uppercase; color: #D9D2C4; opacity: .85; }
  .tkx .scroll i { display: block; width: 1px; height: 46px; margin: 14px auto 0; background: linear-gradient(var(--brass), transparent); animation: tkxDrop 2.4s ease-in-out infinite; }
  @keyframes tkxDrop { 0%,100% { opacity: .3; transform: scaleY(.6); } 50% { opacity: 1; transform: scaleY(1); } }

  /* WHISPER strip */
  .tkx .whisper { background: var(--sand); border-top: 1px solid var(--mist); border-bottom: 1px solid var(--mist); text-align: center; padding: 22px 28px; font-size: 13.5px; letter-spacing: .04em; color: var(--sage-d); }

  /* Generic section */
  .tkx .sec { padding: clamp(72px, 11vw, 150px) 0; }
  .tkx .sec h2 { font-size: clamp(28px, 4.4vw, 50px); line-height: 1.1; margin: 0 0 22px; }
  .tkx .lead { font-size: clamp(16px, 1.7vw, 19px); color: #5a5f5a; max-width: 620px; }

  /* PROBLEM (dark, parallax) */
  .tkx .problem { position: relative; color: #EDE8DC; text-align: center; overflow: hidden; }
  .tkx .problem__bg { position: absolute; inset: 0; z-index: 0; background-size: cover; background-position: center; background-attachment: fixed; }
  .tkx .problem__veil { position: absolute; inset: 0; z-index: 1; background: linear-gradient(180deg, rgba(13,44,52,.82), rgba(8,28,33,.92)); }
  .tkx .problem .inner { position: relative; z-index: 2; }
  .tkx .problem h2 { color: #F4EFE3; }
  .tkx .problem .lead { color: #C9CFC6; margin: 0 auto; }

  /* SOLUTION (light split) */
  .tkx .split { display: grid; grid-template-columns: 1fr 1fr; gap: clamp(28px, 5vw, 80px); align-items: center; }
  .tkx .media { position: relative; border-radius: 4px; overflow: hidden; aspect-ratio: 4/5; background: linear-gradient(150deg, var(--sage) 0%, var(--o) 100%); box-shadow: 0 30px 70px -30px rgba(19,59,70,.45); }
  .tkx .media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .tkx .media--float { animation: tkxFloat 7s ease-in-out infinite; }
  @keyframes tkxFloat { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-12px); } }

  /* LIVE MAP */
  .tkx .mapwrap { background: var(--o); color: #EDE8DC; border-radius: 4px; padding: clamp(36px,6vw,72px); text-align: center; }
  .tkx .mapwrap h2 { color: #F4EFE3; }
  .tkx .mapwrap .lead { color: #BFC7BD; margin: 0 auto 36px; }
  .tkx .map { position: relative; height: 280px; max-width: 620px; margin: 0 auto; border-radius: 4px; overflow: hidden; background: radial-gradient(circle at 50% 40%, #1c4a54, #0e2f37); border: 1px solid rgba(183,154,107,.25); }
  .tkx .map .grid { position: absolute; inset: 0; background-image: linear-gradient(rgba(183,154,107,.10) 1px,transparent 1px),linear-gradient(90deg,rgba(183,154,107,.10) 1px,transparent 1px); background-size: 44px 44px; }
  .tkx .map .ping, .tkx .map .core { position: absolute; border-radius: 50%; animation: tkxMove 11s ease-in-out infinite; }
  .tkx .map .core { width: 16px; height: 16px; background: var(--brass); box-shadow: 0 0 16px rgba(183,154,107,.9); z-index: 2; }
  .tkx .map .ping { width: 16px; height: 16px; background: var(--brass); animation: tkxMove 11s ease-in-out infinite, tkxPing 2.6s ease-out infinite; }
  @keyframes tkxPing { 0% { box-shadow: 0 0 0 0 rgba(183,154,107,.5); } 70% { box-shadow: 0 0 0 32px rgba(183,154,107,0); } 100% { box-shadow: 0 0 0 0 rgba(183,154,107,0); } }
  @keyframes tkxMove { 0% { left: 16%; top: 66%; } 25% { left: 42%; top: 30%; } 50% { left: 68%; top: 52%; } 75% { left: 84%; top: 26%; } 100% { left: 16%; top: 66%; } }

  /* FEATURES */
  .tkx .feats { display: grid; grid-template-columns: repeat(2,1fr); gap: 2px; background: var(--mist); border: 1px solid var(--mist); border-radius: 4px; overflow: hidden; }
  .tkx .feat { background: var(--cashmere); padding: clamp(28px,4vw,46px); transition: background .4s ease; }
  .tkx .feat:hover { background: #FBF9F3; }
  .tkx .feat .fi { width: 34px; height: 34px; margin-bottom: 18px; color: var(--sage-d); }
  .tkx .feat h3 { font-family: 'Fraunces',serif; font-weight: 500; font-size: 22px; margin: 0 0 8px; color: var(--o); }
  .tkx .feat p { margin: 0; font-size: 15.5px; color: #5a5f5a; }

  /* MOMENT (full-bleed) */
  .tkx .moment { position: relative; min-height: 70vh; display: flex; align-items: center; justify-content: center; text-align: center; color: #F4EFE3; overflow: hidden; }
  .tkx .moment__bg { position: absolute; inset: 0; z-index: 0; background-size: cover; background-position: center; background-attachment: fixed; }
  .tkx .moment__veil { position: absolute; inset: 0; z-index: 1; background: linear-gradient(180deg, rgba(92,107,87,.45), rgba(13,44,52,.7)); }
  .tkx .moment .q { position: relative; z-index: 2; font-family: 'Fraunces',serif; font-weight: 500; font-size: clamp(26px,4.6vw,54px); line-height: 1.18; max-width: 900px; padding: 0 28px; }

  /* TRUST facts */
  .tkx .facts { display: grid; grid-template-columns: repeat(3,1fr); gap: 22px; }
  .tkx .fact { text-align: center; padding: 36px 22px; border: 1px solid var(--mist); border-radius: 4px; background: #FBF9F3; transition: transform .4s ease, box-shadow .4s ease; }
  .tkx .fact:hover { transform: translateY(-6px); box-shadow: 0 24px 50px -28px rgba(19,59,70,.35); }
  .tkx .fact .fi { width: 30px; height: 30px; margin-bottom: 14px; color: var(--brass); }
  .tkx .fact h3 { font-family: 'Fraunces',serif; font-weight: 500; font-size: 19px; color: var(--o); margin: 0 0 6px; }
  .tkx .fact p { margin: 0; font-size: 14.5px; color: #5a5f5a; }

  /* GUARANTEE */
  .tkx .guarantee { text-align: center; background: var(--sand); border-radius: 4px; padding: clamp(48px,7vw,90px) 28px; }
  .tkx .guarantee h2 { color: var(--o); }
  .tkx .guarantee .lead { margin: 0 auto; color: #5a5f5a; }

  /* FAQ */
  .tkx .faq { max-width: 760px; margin: 0 auto; }
  .tkx details { border-bottom: 1px solid var(--mist); }
  .tkx details summary { display: flex; justify-content: space-between; align-items: center; gap: 20px; padding: 26px 4px; cursor: pointer; list-style: none; font-family: 'Fraunces',serif; font-size: 20px; color: var(--ink); }
  .tkx details summary::-webkit-details-marker { display: none; }
  .tkx details .ar { color: var(--brass); font-size: 22px; transition: transform .3s ease; flex: 0 0 auto; }
  .tkx details[open] .ar { transform: rotate(45deg); }
  .tkx details p { margin: 0 4px 26px; color: #5a5f5a; font-size: 16px; }

  /* FINAL */
  .tkx .final { position: relative; text-align: center; color: #F4EFE3; overflow: hidden; background: linear-gradient(150deg, var(--o) 0%, var(--sage-d) 100%); border-radius: 4px; padding: clamp(64px,9vw,120px) 28px; }
  .tkx .final h2 { color: #F8F5EE; }
  .tkx .final .lead { color: #D7DCD2; margin: 0 auto 36px; }
  .tkx .price { display: inline-flex; align-items: baseline; gap: 12px; margin: 4px 0 30px; color: #F4EFE3; }
  .tkx .price .now { font-family: 'Fraunces',serif; font-size: 32px; font-weight: 500; }
  .tkx .price .old { font-size: 18px; opacity: .65; text-decoration: line-through; }
  .tkx .note { margin-top: 18px; font-size: 13px; letter-spacing: .04em; color: rgba(244,239,227,.8); }

  /* STICKY mobile */
  .tkx .sticky { position: fixed; left: 0; right: 0; bottom: 0; z-index: 60; display: none; align-items: center; justify-content: space-between; gap: 14px; background: var(--cashmere); border-top: 1px solid var(--mist); padding: 12px 18px calc(12px + env(safe-area-inset-bottom)); box-shadow: 0 -8px 26px rgba(19,59,70,.12); }
  .tkx .sticky .p { font-family: 'Fraunces',serif; font-size: 18px; color: var(--o); }
  .tkx .sticky .btn { flex: 1; max-width: 220px; padding: 13px 18px; text-align: center; }

  @media (max-width: 820px) {
    .tkx .split { grid-template-columns: 1fr; }
    .tkx .feats { grid-template-columns: 1fr; }
    .tkx .facts { grid-template-columns: 1fr; }
    .tkx .problem__bg, .tkx .moment__bg { background-attachment: scroll; }
    .tkx .sticky { display: flex; }
    .tkx-pad { padding-bottom: 80px; }
  }
  @media (prefers-reduced-motion: reduce) {
    .tkx .hero__bg, .tkx .map .core, .tkx .map .ping, .tkx .media--float, .tkx .scroll i { animation: none !important; }
    .tkx .rv { transition: none !important; opacity: 1 !important; transform: none !important; }
  }
{% endstyle %}

<div class="tkx tkx-pad">
  <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" class="tkx-form">
    <input type="hidden" name="form_type" value="product">
    <input type="hidden" name="utf8" value="✓">
    {%- if variant -%}<input type="hidden" name="id" value="{{ variant.id }}">{%- endif -%}

    <!-- HERO -->
    <section class="hero">
      <div class="hero__bg" {% if hero_img %}style="background-image:url('{{ hero_img | image_url: width: 2400 }}')"{% else %}style="background:radial-gradient(120% 120% at 50% 0%, #1c4a54 0%, #0d2c34 60%, #081c21 100%)"{% endif %}></div>
      <div class="hero__veil"></div>
      <div class="hero__in">
        <p class="kicker rv">{{ 'trakora.hero_kicker' | t }}</p>
        <h1 class="serif rv d1">{{ 'trakora.hero_title' | t }}</h1>
        <p class="rv d2">{{ 'trakora.hero_sub' | t }}</p>
        {%- if variant -%}
          <button type="submit" class="btn btn--ondark rv d3"><span>{{ 'trakora.hero_cta' | t }}</span></button>
        {%- else -%}
          <a href="#tkx-buy" class="btn btn--ondark rv d3"><span>{{ 'trakora.hero_cta' | t }}</span></a>
        {%- endif -%}
        <div class="scroll rv d4">{{ 'trakora.hero_scroll' | t }}<i></i></div>
      </div>
    </section>

    <!-- WHISPER -->
    <div class="whisper">{{ 'trakora.whisper' | t }}</div>

    <!-- PROBLEM -->
    <section class="sec problem">
      <div class="problem__bg" {% if problem_img %}style="background-image:url('{{ problem_img | image_url: width: 2400 }}')"{% else %}style="background:linear-gradient(160deg,#0e2f37,#081c21)"{% endif %}></div>
      <div class="problem__veil"></div>
      <div class="inner wrap narrow" style="margin:0 auto;">
        <p class="kicker rv">{{ 'trakora.problem_kicker' | t }}</p>
        <h2 class="serif rv d1">{{ 'trakora.problem_title' | t }}</h2>
        <p class="lead rv d2">{{ 'trakora.problem_text' | t }}</p>
      </div>
    </section>

    <!-- SOLUTION -->
    <section class="sec">
      <div class="wrap split">
        <div class="media media--float rv">
          {%- if solution_img -%}<img src="{{ solution_img | image_url: width: 1200 }}" alt="">{%- endif -%}
        </div>
        <div class="rv d1">
          <p class="kicker">{{ 'trakora.solution_kicker' | t }}</p>
          <h2 class="serif">{{ 'trakora.solution_title' | t }}</h2>
          <p class="lead">{{ 'trakora.solution_text' | t }}</p>
        </div>
      </div>
    </section>

    <!-- LIVE MAP -->
    <section class="sec" style="padding-top:0;">
      <div class="wrap">
        <div class="mapwrap rv">
          <p class="kicker" style="color:var(--brass)">{{ 'trakora.map_kicker' | t }}</p>
          <h2 class="serif">{{ 'trakora.map_title' | t }}</h2>
          <p class="lead">{{ 'trakora.map_text' | t }}</p>
          <div class="map">
            <div class="grid"></div>
            <div class="ping"></div>
            <div class="core"></div>
          </div>
        </div>
      </div>
    </section>

    <!-- FEATURES -->
    <section class="sec" style="padding-top:0;">
      <div class="wrap">
        <h2 class="serif rv" style="text-align:center;margin-bottom:48px;">{{ 'trakora.features_title' | t }}</h2>
        <div class="feats">
          <div class="feat rv"><div class="fi">📍</div><h3>{{ 'trakora.feat1_t' | t }}</h3><p>{{ 'trakora.feat1_d' | t }}</p></div>
          <div class="feat rv d1"><div class="fi">🛡️</div><h3>{{ 'trakora.feat2_t' | t }}</h3><p>{{ 'trakora.feat2_d' | t }}</p></div>
          <div class="feat rv d2"><div class="fi">🔋</div><h3>{{ 'trakora.feat3_t' | t }}</h3><p>{{ 'trakora.feat3_d' | t }}</p></div>
          <div class="feat rv d3"><div class="fi">💧</div><h3>{{ 'trakora.feat4_t' | t }}</h3><p>{{ 'trakora.feat4_d' | t }}</p></div>
        </div>
      </div>
    </section>

    <!-- MOMENT -->
    <section class="moment">
      <div class="moment__bg" {% if moment_img %}style="background-image:url('{{ moment_img | image_url: width: 2400 }}')"{% else %}style="background:linear-gradient(160deg,#5C6B57,#133B46)"{% endif %}></div>
      <div class="moment__veil"></div>
      <p class="q rv">{{ 'trakora.moment_text' | t }}</p>
    </section>

    <!-- TRUST FACTS -->
    <section class="sec">
      <div class="wrap">
        <h2 class="serif rv" style="text-align:center;margin-bottom:46px;">{{ 'trakora.trust_title' | t }}</h2>
        <div class="facts">
          <div class="fact rv"><div class="fi">📡</div><h3>{{ 'trakora.trust1_t' | t }}</h3><p>{{ 'trakora.trust1_d' | t }}</p></div>
          <div class="fact rv d1"><div class="fi">✦</div><h3>{{ 'trakora.trust2_t' | t }}</h3><p>{{ 'trakora.trust2_d' | t }}</p></div>
          <div class="fact rv d2"><div class="fi">🛡️</div><h3>{{ 'trakora.trust3_t' | t }}</h3><p>{{ 'trakora.trust3_d' | t }}</p></div>
        </div>
      </div>
    </section>

    <!-- GUARANTEE -->
    <section class="sec" style="padding-top:0;">
      <div class="wrap">
        <div class="guarantee rv">
          <h2 class="serif">{{ 'trakora.guarantee_title' | t }}</h2>
          <p class="lead">{{ 'trakora.guarantee_text' | t }}</p>
        </div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="sec" style="padding-top:0;">
      <div class="wrap">
        <h2 class="serif rv" style="text-align:center;margin-bottom:36px;">{{ 'trakora.faq_title' | t }}</h2>
        <div class="faq rv">
          <details open><summary>{{ 'trakora.faq1_q' | t }}<span class="ar">+</span></summary><p>{{ 'trakora.faq1_a' | t }}</p></details>
          <details><summary>{{ 'trakora.faq2_q' | t }}<span class="ar">+</span></summary><p>{{ 'trakora.faq2_a' | t }}</p></details>
          <details><summary>{{ 'trakora.faq3_q' | t }}<span class="ar">+</span></summary><p>{{ 'trakora.faq3_a' | t }}</p></details>
          <details><summary>{{ 'trakora.faq4_q' | t }}<span class="ar">+</span></summary><p>{{ 'trakora.faq4_a' | t }}</p></details>
        </div>
      </div>
    </section>

    <!-- FINAL -->
    <section id="tkx-buy" class="sec" style="padding-top:0;">
      <div class="wrap">
        <div class="final rv">
          <p class="kicker" style="color:#D9C7A3">{{ 'trakora.final_kicker' | t }}</p>
          <h2 class="serif">{{ 'trakora.final_title' | t }}</h2>
          <p class="lead">{{ 'trakora.final_text' | t }}</p>
          {%- if variant -%}
            <div class="price">
              <span class="now">{{ variant.price | money }}</span>
              {%- if variant.compare_at_price > variant.price -%}<span class="old">{{ variant.compare_at_price | money }}</span>{%- endif -%}
            </div>
            <div><button type="submit" class="btn btn--ondark"><span>{{ 'trakora.final_cta' | t }}</span></button></div>
          {%- else -%}
            <a href="{{ routes.all_products_collection_url }}" class="btn btn--ondark"><span>{{ 'trakora.final_cta' | t }}</span></a>
          {%- endif -%}
          <div class="note">{{ 'trakora.guarantee_note' | t }}</div>
        </div>
      </div>
    </section>

    <!-- STICKY mobile -->
    {%- if variant -%}
      <div class="sticky">
        <div><span class="p">{{ variant.price | money }}</span></div>
        <button type="submit" class="btn"><span>{{ 'trakora.final_cta' | t }}</span></button>
      </div>
    {%- endif -%}

  </form>
</div>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var els = root.querySelectorAll('.rv');
    if (!('IntersectionObserver' in window)) { els.forEach(function (e) { e.classList.add('in'); }); return; }
    var io = new IntersectionObserver(function (en) {
      en.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
    }, { threshold: 0.14 });
    els.forEach(function (e) { io.observe(e); });
  })();
</script>

{% schema %}
{
  "name": "TRAKORA Home",
  "tag": "section",
  "settings": [
    { "type": "product", "id": "product", "label": "Produkt (Kaufen-Buttons)", "info": "Der GPS-Tracker. Buttons legen ihn direkt in den Warenkorb." },
    { "type": "header", "content": "Bilder (optional – ohne Bild zeigen edle Verläufe)" },
    { "type": "image_picker", "id": "hero_image", "label": "Hero-Hintergrund" },
    { "type": "image_picker", "id": "problem_image", "label": "Problem-Sektion Hintergrund" },
    { "type": "image_picker", "id": "solution_image", "label": "Lösung – Produktbild" },
    { "type": "image_picker", "id": "moment_image", "label": "Emotionaler Moment – Hintergrund" }
  ],
  "presets": [ { "name": "TRAKORA Home" } ]
}
{% endschema %}
