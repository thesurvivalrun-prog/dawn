{%- liquid
  assign product = section.settings.product
-%}

{% style %}
  .tk-wrap {
    --tk-blue: #1E3A8A;
    --tk-blue-2: #2563eb;
    --tk-green: #22C55E;
    --tk-green-2: #16a34a;
    --tk-orange: #F59E0B;
    --tk-bg: #F9FAFB;
    --tk-line: #E5E7EB;
    --tk-ink: #0F172A;
    --tk-muted: #475569;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    color: var(--tk-ink);
    line-height: 1.6;
    overflow-x: hidden;
  }
  .tk-container { max-width: 1080px; margin: 0 auto; padding: 0 20px; }
  .tk-narrow { max-width: 720px; margin: 0 auto; }

  /* Reveal on scroll */
  .tk-reveal { opacity: 0; transform: translateY(26px); transition: opacity .7s ease, transform .7s ease; }
  .tk-reveal.tk-in { opacity: 1; transform: none; }

  /* HERO */
  .tk-hero { text-align: center; background: linear-gradient(160deg,#1E3A8A 0%,#1e40af 58%,#2563eb 100%); border-radius: 28px; padding: 72px 28px; color: #fff; margin-top: 22px; }
  .tk-badge { display: inline-block; background: rgba(255,255,255,.15); padding: 8px 18px; border-radius: 999px; font-size: 13px; letter-spacing: .4px; margin-bottom: 22px; }
  .tk-hero h1 { font-size: clamp(32px, 6vw, 50px); line-height: 1.1; margin: 0 0 16px; font-weight: 800; letter-spacing: -.5px; }
  .tk-hero p { font-size: clamp(16px,2.4vw,20px); opacity: .92; max-width: 580px; margin: 0 auto 30px; }

  .tk-cta { display: inline-block; background: var(--tk-orange); color: #1f2937; font-weight: 700; font-size: 17px; padding: 16px 40px; border: none; border-radius: 14px; text-decoration: none; cursor: pointer; box-shadow: 0 10px 26px rgba(245,158,11,.4); transition: transform .2s ease, box-shadow .2s ease; }
  .tk-cta:hover { transform: translateY(-3px) scale(1.02); box-shadow: 0 16px 34px rgba(245,158,11,.5); }
  .tk-cta-note { margin-top: 18px; font-size: 13px; opacity: .85; }

  .tk-section { padding: 64px 0 8px; text-align: center; }
  .tk-section h2 { font-size: clamp(24px,4vw,30px); font-weight: 800; letter-spacing: -.4px; margin: 0 0 16px; }
  .tk-lead { font-size: 17px; color: var(--tk-muted); max-width: 640px; margin: 0 auto; }

  /* MAP */
  .tk-map-card { margin: 44px auto; background: var(--tk-bg); border: 1px solid var(--tk-line); border-radius: 28px; padding: 40px 28px; text-align: center; max-width: 1080px; }
  .tk-eyebrow { font-size: 13px; font-weight: 700; color: var(--tk-green); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 8px; }
  .tk-map { position: relative; height: 260px; max-width: 580px; margin: 0 auto; border-radius: 20px; overflow: hidden; background: linear-gradient(135deg,#e0f2fe,#dcfce7); border: 1px solid var(--tk-line); }
  .tk-grid { position: absolute; inset: 0; background-image: linear-gradient(#cbd5e1 1px,transparent 1px),linear-gradient(90deg,#cbd5e1 1px,transparent 1px); background-size: 40px 40px; opacity: .5; }
  .tk-dot, .tk-pulse { position: absolute; width: 20px; height: 20px; border-radius: 50%; animation: tkMove 9s ease-in-out infinite; }
  .tk-dot { background: var(--tk-blue); border: 3px solid #fff; box-shadow: 0 4px 12px rgba(0,0,0,.3); z-index: 2; }
  .tk-pulse { background: var(--tk-green); animation: tkMove 9s ease-in-out infinite, tkPulse 2.2s ease-out infinite; }
  @keyframes tkPulse { 0% { box-shadow: 0 0 0 0 rgba(34,197,94,.5); } 70% { box-shadow: 0 0 0 26px rgba(34,197,94,0); } 100% { box-shadow: 0 0 0 0 rgba(34,197,94,0); } }
  @keyframes tkMove { 0% { left: 12%; top: 64%; } 25% { left: 40%; top: 28%; } 50% { left: 66%; top: 50%; } 75% { left: 82%; top: 22%; } 100% { left: 12%; top: 64%; } }

  /* FEATURES */
  .tk-feats { display: flex; flex-wrap: wrap; gap: 16px; justify-content: center; margin-top: 30px; }
  .tk-feat { flex: 1 1 240px; max-width: 250px; background: #fff; border: 1px solid var(--tk-line); border-radius: 20px; padding: 26px; text-align: left; transition: transform .25s ease, box-shadow .25s ease; }
  .tk-feat:hover { transform: translateY(-5px); box-shadow: 0 16px 36px rgba(30,58,138,.14); }
  .tk-feat .ic { font-size: 30px; margin-bottom: 12px; }
  .tk-feat h3 { margin: 0 0 6px; font-size: 17px; font-weight: 700; color: var(--tk-blue); }
  .tk-feat p { margin: 0; font-size: 14px; color: var(--tk-muted); }

  /* TRUST */
  .tk-trust { margin: 56px auto; background: var(--tk-blue); border-radius: 28px; padding: 48px 28px; color: #fff; text-align: center; max-width: 1080px; }
  .tk-stats { display: flex; flex-wrap: wrap; justify-content: center; gap: 36px; margin-bottom: 34px; }
  .tk-stats .n { font-size: 34px; font-weight: 800; }
  .tk-stats .l { font-size: 13px; opacity: .85; }
  .tk-reviews { display: flex; flex-wrap: wrap; gap: 16px; justify-content: center; text-align: left; }
  .tk-review { flex: 1 1 240px; max-width: 300px; background: rgba(255,255,255,.08); border-radius: 18px; padding: 22px; }
  .tk-review .stars { color: var(--tk-orange); margin-bottom: 8px; }
  .tk-review p { margin: 0 0 10px; font-size: 14px; opacity: .95; }
  .tk-review .who { font-size: 13px; opacity: .7; }

  .tk-guarantee { display: inline-flex; flex-wrap: wrap; gap: 24px; justify-content: center; font-size: 15px; color: #334155; margin-top: 36px; }

  /* FAQ */
  .tk-faq { margin: 30px auto 0; }
  .tk-faq details { background: var(--tk-bg); border: 1px solid var(--tk-line); border-radius: 16px; padding: 2px 22px; margin-bottom: 12px; text-align: left; }
  .tk-faq summary { display: flex; justify-content: space-between; align-items: center; padding: 18px 0; font-weight: 700; font-size: 16px; cursor: pointer; list-style: none; }
  .tk-faq summary::-webkit-details-marker { display: none; }
  .tk-faq .arrow { color: var(--tk-green); font-size: 20px; transition: transform .2s ease; }
  .tk-faq details[open] .arrow { transform: rotate(45deg); }
  .tk-faq p { margin: 0 0 18px; color: var(--tk-muted); font-size: 15px; }

  /* FINAL */
  .tk-final { text-align: center; background: linear-gradient(160deg,#16a34a 0%,#22C55E 100%); border-radius: 28px; padding: 60px 28px; color: #fff; margin: 64px 0 24px; }
  .tk-final h2 { font-size: clamp(26px,5vw,34px); font-weight: 800; letter-spacing: -.4px; margin: 0 0 14px; }
  .tk-final p { font-size: 17px; opacity: .95; max-width: 540px; margin: 0 auto 28px; }

  .tk-price { display: inline-flex; align-items: baseline; gap: 12px; margin: 6px 0 22px; }
  .tk-price .now { font-size: 30px; font-weight: 800; }
  .tk-price .old { font-size: 18px; opacity: .7; text-decoration: line-through; }

  @media (max-width: 600px) {
    .tk-hero { padding: 54px 20px; border-radius: 22px; }
    .tk-guarantee { gap: 14px; }
  }
{% endstyle %}

<div class="tk-wrap">

  {%- comment -%} The whole landing is wrapped in a cart form so every CTA adds to cart {%- endcomment -%}
  {%- assign variant = product.selected_or_first_available_variant -%}
  <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" id="tk-buy-form" class="tk-form">
    <input type="hidden" name="form_type" value="product">
    <input type="hidden" name="utf8" value="✓">
    <input type="hidden" name="id" value="{{ variant.id }}">

  <div class="tk-container">

    <!-- HERO -->
    <section class="tk-hero tk-reveal">
      <span class="tk-badge">⭐️ 4,8/5 von über 10.000 Tierbesitzern</span>
      <h1>Verliere dein Haustier<br>nie wieder.</h1>
      <p>Echtzeit-GPS-Tracking für absolute Sicherheit – für Hund &amp; Katze, weltweit, direkt auf deinem Handy.</p>
      {%- if product != blank -%}
        <button type="submit" class="tk-cta">Jetzt schützen →</button>
      {%- else -%}
        <a href="#tk-buy" class="tk-cta">Jetzt schützen →</a>
      {%- endif -%}
      <div class="tk-cta-note">🔒 30 Tage Geld-zurück-Garantie · 🚚 Kostenloser Versand</div>
    </section>

    <!-- PROBLEM -->
    <section class="tk-section tk-reveal">
      <div class="tk-narrow">
        <h2>Ein offenes Tor. Eine Sekunde. Und er ist weg.</h2>
        <p class="tk-lead">Jeden Tag verschwinden tausende Haustiere – ein aufgeschrecktes Tier rennt schneller, als du reagieren kannst. Die Stunden der Ungewissheit sind das Schlimmste. Genau dafür gibt es TRAKORA: damit du immer weißt, wo dein Liebling ist.</p>
      </div>
    </section>
  </div>

  <!-- SOLUTION / LIVE MAP -->
  <div class="tk-container">
    <section class="tk-map-card tk-reveal">
      <div class="tk-eyebrow">● Live-Ortung</div>
      <h2 style="font-size:clamp(22px,4vw,28px);font-weight:800;margin:0 0 24px;">Du öffnest die App – und siehst ihn sofort.</h2>
      <div class="tk-map">
        <div class="tk-grid"></div>
        <div class="tk-pulse"></div>
        <div class="tk-dot"></div>
      </div>
      <p class="tk-lead" style="margin-top:24px;">Der Standortpunkt bewegt sich in Echtzeit mit deinem Tier. Setze einen sicheren Bereich – verlässt dein Liebling ihn, bekommst du sofort eine Benachrichtigung.</p>
    </section>
  </div>

  <!-- FEATURES -->
  <div class="tk-container">
    <section class="tk-section tk-reveal">
      <h2>Alles, was echte Sicherheit braucht.</h2>
      <div class="tk-feats">
        <div class="tk-feat"><div class="ic">📍</div><h3>Echtzeit-GPS</h3><p>Live-Standort auf wenige Meter genau – jederzeit auf deinem Handy.</p></div>
        <div class="tk-feat"><div class="ic">🔋</div><h3>Lange Akkulaufzeit</h3><p>Bis zu 7 Tage pro Ladung – kein tägliches Aufladen nötig.</p></div>
        <div class="tk-feat"><div class="ic">💧</div><h3>100% Wasserfest</h3><p>Regen, Pfütze, Bach – der Tracker macht jedes Abenteuer mit.</p></div>
        <div class="tk-feat"><div class="ic">📱</div><h3>App-Steuerung</h3><p>Sicherheitszonen, Verlauf &amp; Alarme – einfach in der kostenlosen App.</p></div>
      </div>
    </section>
  </div>

  <!-- TRUST -->
  <div class="tk-container">
    <section class="tk-trust tk-reveal">
      <div class="tk-stats">
        <div><div class="n">10.000+</div><div class="l">glückliche Tierbesitzer</div></div>
        <div><div class="n">4,8★</div><div class="l">durchschnittliche Bewertung</div></div>
        <div><div class="n">99,9%</div><div class="l">zuverlässige Ortung</div></div>
      </div>
      <div class="tk-reviews">
        <div class="tk-review"><div class="stars">★★★★★</div><p>„Mein Kater war über Nacht weg – mit TRAKORA hatte ich ihn in 10 Minuten gefunden. Unbezahlbar."</p><div class="who">— Sandra K., verifizierter Kauf</div></div>
        <div class="tk-review"><div class="stars">★★★★★</div><p>„Endlich kann ich meinen Hund im Wald frei laufen lassen, ohne Angst. Die App ist kinderleicht."</p><div class="who">— Markus T., verifizierter Kauf</div></div>
        <div class="tk-review"><div class="stars">★★★★★</div><p>„Akku hält ewig, super genau und wasserfest. Genau das, was wir gesucht haben."</p><div class="who">— Lena B., verifizierter Kauf</div></div>
      </div>
    </section>
  </div>

  <!-- GUARANTEE -->
  <div class="tk-container" style="text-align:center;">
    <div class="tk-guarantee tk-reveal">
      <span>🛡️ <strong>30 Tage</strong> Geld-zurück-Garantie</span>
      <span>↩️ <strong>Einfache</strong> Rückgabe</span>
      <span>🚚 <strong>Kostenloser</strong> Versand</span>
    </div>
  </div>

  <!-- FAQ -->
  <div class="tk-container">
    <section class="tk-section tk-reveal">
      <h2>Häufige Fragen</h2>
      <div class="tk-faq tk-narrow">
        <details open>
          <summary>Wie groß ist die Reichweite?<span class="arrow">+</span></summary>
          <p>Unbegrenzt. Der Tracker nutzt GPS &amp; Mobilfunk – du ortest dein Tier überall mit Netzabdeckung, egal ob 100 Meter oder 100 Kilometer entfernt.</p>
        </details>
        <details>
          <summary>Wie lange hält der Akku?<span class="arrow">+</span></summary>
          <p>Je nach Nutzung bis zu 7 Tage pro Ladung. Die App zeigt dir den Akkustand jederzeit an und warnt dich rechtzeitig.</p>
        </details>
        <details>
          <summary>Funktioniert er für Hund und Katze?<span class="arrow">+</span></summary>
          <p>Ja. Der Tracker ist leicht und kompakt und passt an jedes gängige Halsband – für Hunde und Katzen gleichermaßen geeignet.</p>
        </details>
        <details>
          <summary>Brauche ich ein Abo?<span class="arrow">+</span></summary>
          <p>Die App ist kostenlos. Für die Mobilfunk-Ortung wird eine kostengünstige SIM-Verbindung genutzt – alle Details erhältst du mit dem Gerät.</p>
        </details>
        <details>
          <summary>Was, wenn er mir nicht gefällt?<span class="arrow">+</span></summary>
          <p>Kein Risiko: Du hast 30 Tage Zeit. Bist du nicht zufrieden, bekommst du den vollen Kaufpreis zurück – unkompliziert.</p>
        </details>
      </div>
    </section>
  </div>

  <!-- FINAL CTA -->
  <div class="tk-container">
    <section id="tk-buy" class="tk-final tk-reveal">
      <h2>Schütze dein Haustier noch heute.</h2>
      <p>Gib der Ungewissheit keine Chance. Mit TRAKORA weißt du immer, wo dein Liebling ist.</p>
      {%- if product != blank -%}
        <div class="tk-price">
          <span class="now">{{ variant.price | money }}</span>
          {%- if variant.compare_at_price > variant.price -%}
            <span class="old">{{ variant.compare_at_price | money }}</span>
          {%- endif -%}
        </div>
        <br>
        <button type="submit" class="tk-cta" style="font-size:18px;padding:17px 46px;">In den Warenkorb</button>
      {%- else -%}
        <a href="{{ routes.all_products_collection_url }}" class="tk-cta" style="font-size:18px;padding:17px 46px;">Jetzt sichern</a>
      {%- endif -%}
      <div class="tk-cta-note">🛡️ 30 Tage Geld-zurück-Garantie · 🚚 Kostenloser Versand</div>
    </section>
  </div>

  </form>

</div>

<script>
  (function () {
    var els = document.querySelectorAll('#shopify-section-{{ section.id }} .tk-reveal');
    if (!('IntersectionObserver' in window)) { els.forEach(function (e) { e.classList.add('tk-in'); }); return; }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('tk-in'); io.unobserve(en.target); } });
    }, { threshold: 0.12 });
    els.forEach(function (e) { io.observe(e); });
  })();
</script>

{% schema %}
{
  "name": "TRAKORA Landing",
  "tag": "section",
  "class": "tk-section-wrapper",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Produkt (für Kaufen-Buttons)",
      "info": "Wähle den GPS-Tracker. Die Kaufen-Buttons legen dieses Produkt direkt in den Warenkorb."
    }
  ],
  "presets": [
    { "name": "TRAKORA Landing" }
  ]
}
{% endschema %}
