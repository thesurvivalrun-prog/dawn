{%- liquid
  assign product = section.settings.product
  assign variant = product.selected_or_first_available_variant
-%}

{% style %}
  .tk-wrap {
    --tk-blue: #1E3A8A;
    --tk-blue-2: #2563eb;
    --tk-green: #22C55E;
    --tk-green-2: #16a34a;
    --tk-orange: #F59E0B;
    --tk-bg: #F9FAFB;
    --tk-line: #E5E7EB;
    --tk-ink: #0F172A;
    --tk-muted: #475569;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    color: var(--tk-ink);
    line-height: 1.6;
    overflow-x: hidden;
  }
  .tk-container { max-width: 1080px; margin: 0 auto; padding: 0 20px; }
  .tk-narrow { max-width: 720px; margin: 0 auto; }

  /* Reveal on scroll (with stagger) */
  .tk-reveal { opacity: 0; transform: translateY(28px); transition: opacity .7s ease, transform .7s cubic-bezier(.2,.7,.2,1); }
  .tk-reveal.tk-in { opacity: 1; transform: none; }
  .tk-feat.tk-reveal:nth-child(2), .tk-review.tk-reveal:nth-child(2) { transition-delay: .08s; }
  .tk-feat.tk-reveal:nth-child(3), .tk-review.tk-reveal:nth-child(3) { transition-delay: .16s; }
  .tk-feat.tk-reveal:nth-child(4) { transition-delay: .24s; }

  /* HERO */
  .tk-hero { position: relative; text-align: center; border-radius: 28px; padding: 76px 28px; color: #fff; margin-top: 22px; overflow: hidden;
    background: linear-gradient(160deg, #1E3A8A, #1e40af, #2563eb, #1E3A8A); background-size: 220% 220%; animation: tkGradient 16s ease infinite; }
  @keyframes tkGradient { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }
  .tk-hero::after { content: ""; position: absolute; width: 420px; height: 420px; top: -160px; right: -120px; border-radius: 50%; background: radial-gradient(circle, rgba(34,197,94,.35), transparent 70%); animation: tkBlob 12s ease-in-out infinite; }
  @keyframes tkBlob { 0%,100% { transform: translate(0,0) scale(1); } 50% { transform: translate(-30px,40px) scale(1.2); } }
  .tk-hero > * { position: relative; z-index: 1; }
  .tk-badge { display: inline-block; background: rgba(255,255,255,.15); padding: 8px 18px; border-radius: 999px; font-size: 13px; letter-spacing: .4px; margin-bottom: 22px; animation: tkFloat 3.6s ease-in-out infinite; }
  @keyframes tkFloat { 0%,100% { transform: translateY(0); } 50% { transform: translateY(-6px); } }
  .tk-hero h1 { font-size: clamp(32px, 6vw, 52px); line-height: 1.08; margin: 0 0 16px; font-weight: 800; letter-spacing: -.5px; }
  .tk-hero p { font-size: clamp(16px,2.4vw,20px); opacity: .92; max-width: 580px; margin: 0 auto 30px; }

  .tk-cta { display: inline-block; background: var(--tk-orange); color: #1f2937; font-weight: 700; font-size: 17px; padding: 16px 40px; border: none; border-radius: 14px; text-decoration: none; cursor: pointer; box-shadow: 0 10px 26px rgba(245,158,11,.4); transition: transform .2s ease, box-shadow .2s ease; }
  .tk-cta:hover { transform: translateY(-3px) scale(1.02); box-shadow: 0 16px 34px rgba(245,158,11,.55); }
  .tk-cta--pulse { animation: tkGlow 2.6s ease-in-out infinite; }
  @keyframes tkGlow { 0%,100% { box-shadow: 0 10px 26px rgba(245,158,11,.4); } 50% { box-shadow: 0 12px 38px rgba(245,158,11,.75); } }
  .tk-cta-note { margin-top: 18px; font-size: 13px; opacity: .85; }

  .tk-section { padding: 64px 0 8px; text-align: center; }
  .tk-section h2 { font-size: clamp(24px,4vw,30px); font-weight: 800; letter-spacing: -.4px; margin: 0 0 16px; }
  .tk-lead { font-size: 17px; color: var(--tk-muted); max-width: 640px; margin: 0 auto; }

  /* MAP */
  .tk-map-card { margin: 44px auto; background: var(--tk-bg); border: 1px solid var(--tk-line); border-radius: 28px; padding: 40px 28px; text-align: center; max-width: 1080px; }
  .tk-eyebrow { font-size: 13px; font-weight: 700; color: var(--tk-green); letter-spacing: 1px; text-transform: uppercase; margin-bottom: 8px; }
  .tk-map { position: relative; height: 260px; max-width: 580px; margin: 0 auto; border-radius: 20px; overflow: hidden; background: linear-gradient(135deg,#e0f2fe,#dcfce7); border: 1px solid var(--tk-line); }
  .tk-grid { position: absolute; inset: 0; background-image: linear-gradient(#cbd5e1 1px,transparent 1px),linear-gradient(90deg,#cbd5e1 1px,transparent 1px); background-size: 40px 40px; opacity: .5; }
  .tk-dot, .tk-pulse { position: absolute; width: 20px; height: 20px; border-radius: 50%; animation: tkMove 9s ease-in-out infinite; }
  .tk-dot { background: var(--tk-blue); border: 3px solid #fff; box-shadow: 0 4px 12px rgba(0,0,0,.3); z-index: 2; }
  .tk-pulse { background: var(--tk-green); animation: tkMove 9s ease-in-out infinite, tkPulse 2.2s ease-out infinite; }
  @keyframes tkPulse { 0% { box-shadow: 0 0 0 0 rgba(34,197,94,.5); } 70% { box-shadow: 0 0 0 28px rgba(34,197,94,0); } 100% { box-shadow: 0 0 0 0 rgba(34,197,94,0); } }
  @keyframes tkMove { 0% { left: 12%; top: 64%; } 25% { left: 40%; top: 28%; } 50% { left: 66%; top: 50%; } 75% { left: 82%; top: 22%; } 100% { left: 12%; top: 64%; } }

  /* FEATURES */
  .tk-feats { display: flex; flex-wrap: wrap; gap: 16px; justify-content: center; margin-top: 30px; }
  .tk-feat { flex: 1 1 240px; max-width: 250px; background: #fff; border: 1px solid var(--tk-line); border-radius: 20px; padding: 26px; text-align: left; transition: transform .25s ease, box-shadow .25s ease, opacity .7s ease; }
  .tk-feat:hover { transform: translateY(-6px); box-shadow: 0 16px 36px rgba(30,58,138,.16); }
  .tk-feat .ic { font-size: 30px; margin-bottom: 12px; display: inline-block; transition: transform .25s ease; }
  .tk-feat:hover .ic { transform: scale(1.18) rotate(-6deg); }
  .tk-feat h3 { margin: 0 0 6px; font-size: 17px; font-weight: 700; color: var(--tk-blue); }
  .tk-feat p { margin: 0; font-size: 14px; color: var(--tk-muted); }

  /* TRUST */
  .tk-trust { margin: 56px auto; background: var(--tk-blue); border-radius: 28px; padding: 48px 28px; color: #fff; text-align: center; max-width: 1080px; }
  .tk-stats { display: flex; flex-wrap: wrap; justify-content: center; gap: 36px; margin-bottom: 34px; }
  .tk-stats .n { font-size: 34px; font-weight: 800; }
  .tk-stats .l { font-size: 13px; opacity: .85; }
  .tk-reviews { display: flex; flex-wrap: wrap; gap: 16px; justify-content: center; text-align: left; }
  .tk-review { flex: 1 1 240px; max-width: 300px; background: rgba(255,255,255,.08); border-radius: 18px; padding: 22px; transition: transform .25s ease, opacity .7s ease; }
  .tk-review:hover { transform: translateY(-4px); }
  .tk-review .stars { color: var(--tk-orange); margin-bottom: 8px; }
  .tk-review p { margin: 0; font-size: 14px; opacity: .9; }
  .tk-review .who { font-size: 13px; opacity: .7; }
  .tk-review .tk-tic { font-size: 30px; margin-bottom: 10px; }
  .tk-review h3 { margin: 0 0 6px; font-size: 17px; font-weight: 700; color: #fff; }

  .tk-guarantee { display: inline-flex; flex-wrap: wrap; gap: 24px; justify-content: center; font-size: 15px; color: #334155; margin-top: 36px; }

  /* FAQ */
  .tk-faq { margin: 30px auto 0; }
  .tk-faq details { background: var(--tk-bg); border: 1px solid var(--tk-line); border-radius: 16px; padding: 2px 22px; margin-bottom: 12px; text-align: left; transition: border-color .2s ease; }
  .tk-faq details[open] { border-color: var(--tk-green); }
  .tk-faq summary { display: flex; justify-content: space-between; align-items: center; padding: 18px 0; font-weight: 700; font-size: 16px; cursor: pointer; list-style: none; }
  .tk-faq summary::-webkit-details-marker { display: none; }
  .tk-faq .arrow { color: var(--tk-green); font-size: 20px; transition: transform .25s ease; }
  .tk-faq details[open] .arrow { transform: rotate(45deg); }
  .tk-faq p { margin: 0 0 18px; color: var(--tk-muted); font-size: 15px; }

  /* FINAL */
  .tk-final { text-align: center; background: linear-gradient(160deg,#16a34a 0%,#22C55E 100%); border-radius: 28px; padding: 60px 28px; color: #fff; margin: 64px 0 24px; }
  .tk-final h2 { font-size: clamp(26px,5vw,34px); font-weight: 800; letter-spacing: -.4px; margin: 0 0 14px; }
  .tk-final p { font-size: 17px; opacity: .95; max-width: 540px; margin: 0 auto 28px; }
  .tk-price { display: inline-flex; align-items: baseline; gap: 12px; margin: 6px 0 22px; }
  .tk-price .now { font-size: 30px; font-weight: 800; }
  .tk-price .old { font-size: 18px; opacity: .7; text-decoration: line-through; }

  /* STICKY MOBILE BUY BAR */
  .tk-sticky { position: fixed; left: 0; right: 0; bottom: 0; z-index: 50; display: none; align-items: center; justify-content: space-between; gap: 12px; background: #fff; border-top: 1px solid var(--tk-line); padding: 10px 16px calc(10px + env(safe-area-inset-bottom)); box-shadow: 0 -6px 20px rgba(0,0,0,.1); }
  .tk-sticky .info { line-height: 1.2; }
  .tk-sticky .info .p { font-weight: 800; color: var(--tk-blue); font-size: 17px; }
  .tk-sticky .info .o { font-size: 12px; color: #94a3b8; text-decoration: line-through; margin-left: 6px; }
  .tk-sticky button { flex: 1; max-width: 220px; font-size: 15px; padding: 13px 18px; }

  @media (max-width: 749px) {
    .tk-hero { padding: 56px 20px; border-radius: 22px; }
    .tk-section { padding: 48px 0 6px; }
    .tk-map-card, .tk-trust { border-radius: 22px; padding: 32px 20px; }
    .tk-map { height: 210px; }
    .tk-stats { gap: 22px; }
    .tk-stats .n { font-size: 28px; }
    .tk-feat { max-width: 100%; }
    .tk-review { max-width: 100%; }
    .tk-guarantee { gap: 12px; font-size: 14px; }
    .tk-final { padding: 48px 20px; }
    .tk-sticky { display: flex; }
    .tk-wrap { padding-bottom: 74px; } /* room for sticky bar */
  }

  @media (prefers-reduced-motion: reduce) {
    .tk-hero, .tk-hero::after, .tk-badge, .tk-cta--pulse, .tk-dot, .tk-pulse { animation: none !important; }
    .tk-reveal { transition: none !important; opacity: 1 !important; transform: none !important; }
  }
{% endstyle %}

<div class="tk-wrap">

  {%- comment -%} Whole landing wrapped in a cart form so every CTA adds to cart {%- endcomment -%}
  <form action="{{ routes.cart_add_url }}" method="post" enctype="multipart/form-data" id="tk-buy-form" class="tk-form">
    <input type="hidden" name="form_type" value="product">
    <input type="hidden" name="utf8" value="✓">
    {%- if variant -%}<input type="hidden" name="id" value="{{ variant.id }}">{%- endif -%}

  <div class="tk-container">

    <!-- HERO -->
    <section class="tk-hero tk-reveal">
      <span class="tk-badge">{{ 'trakora.hero_badge' | t }}</span>
      <h1>{{ 'trakora.hero_title' | t }}</h1>
      <p>{{ 'trakora.hero_sub' | t }}</p>
      {%- if variant -%}
        <button type="submit" class="tk-cta tk-cta--pulse">{{ 'trakora.hero_cta' | t }}</button>
      {%- else -%}
        <a href="#tk-buy" class="tk-cta tk-cta--pulse">{{ 'trakora.hero_cta' | t }}</a>
      {%- endif -%}
      <div class="tk-cta-note">{{ 'trakora.guarantee_note' | t }}</div>
    </section>

    <!-- PROBLEM -->
    <section class="tk-section tk-reveal">
      <div class="tk-narrow">
        <h2>{{ 'trakora.problem_title' | t }}</h2>
        <p class="tk-lead">{{ 'trakora.problem_text' | t }}</p>
      </div>
    </section>
  </div>

  <!-- SOLUTION / LIVE MAP -->
  <div class="tk-container">
    <section class="tk-map-card tk-reveal">
      <div class="tk-eyebrow">{{ 'trakora.map_eyebrow' | t }}</div>
      <h2 style="font-size:clamp(22px,4vw,28px);font-weight:800;margin:0 0 24px;">{{ 'trakora.map_title' | t }}</h2>
      <div class="tk-map">
        <div class="tk-grid"></div>
        <div class="tk-pulse"></div>
        <div class="tk-dot"></div>
      </div>
      <p class="tk-lead" style="margin-top:24px;">{{ 'trakora.map_text' | t }}</p>
    </section>
  </div>

  <!-- FEATURES -->
  <div class="tk-container">
    <section class="tk-section">
      <h2 class="tk-reveal">{{ 'trakora.features_title' | t }}</h2>
      <div class="tk-feats">
        <div class="tk-feat tk-reveal"><div class="ic">📍</div><h3>{{ 'trakora.feat1_t' | t }}</h3><p>{{ 'trakora.feat1_d' | t }}</p></div>
        <div class="tk-feat tk-reveal"><div class="ic">🔋</div><h3>{{ 'trakora.feat2_t' | t }}</h3><p>{{ 'trakora.feat2_d' | t }}</p></div>
        <div class="tk-feat tk-reveal"><div class="ic">💧</div><h3>{{ 'trakora.feat3_t' | t }}</h3><p>{{ 'trakora.feat3_d' | t }}</p></div>
        <div class="tk-feat tk-reveal"><div class="ic">📱</div><h3>{{ 'trakora.feat4_t' | t }}</h3><p>{{ 'trakora.feat4_d' | t }}</p></div>
      </div>
    </section>
  </div>

  <!-- TRUST -->
  <div class="tk-container">
    <section class="tk-trust tk-reveal">
      <h2 style="font-size:clamp(22px,4vw,28px);font-weight:800;margin:0 0 30px;color:#fff;">{{ 'trakora.trust_title' | t }}</h2>
      <div class="tk-reviews">
        <div class="tk-review tk-reveal"><div class="tk-tic">📡</div><h3>{{ 'trakora.trust1_t' | t }}</h3><p>{{ 'trakora.trust1_d' | t }}</p></div>
        <div class="tk-review tk-reveal"><div class="tk-tic">🔋</div><h3>{{ 'trakora.trust2_t' | t }}</h3><p>{{ 'trakora.trust2_d' | t }}</p></div>
        <div class="tk-review tk-reveal"><div class="tk-tic">🛡️</div><h3>{{ 'trakora.trust3_t' | t }}</h3><p>{{ 'trakora.trust3_d' | t }}</p></div>
      </div>
    </section>
  </div>

  <!-- GUARANTEE -->
  <div class="tk-container" style="text-align:center;">
    <div class="tk-guarantee tk-reveal">
      <span>{{ 'trakora.guarantee1' | t }}</span>
      <span>{{ 'trakora.guarantee2' | t }}</span>
      <span>{{ 'trakora.guarantee3' | t }}</span>
    </div>
  </div>

  <!-- FAQ -->
  <div class="tk-container">
    <section class="tk-section">
      <h2 class="tk-reveal">{{ 'trakora.faq_title' | t }}</h2>
      <div class="tk-faq tk-narrow tk-reveal">
        <details open>
          <summary>{{ 'trakora.faq1_q' | t }}<span class="arrow">+</span></summary>
          <p>{{ 'trakora.faq1_a' | t }}</p>
        </details>
        <details>
          <summary>{{ 'trakora.faq2_q' | t }}<span class="arrow">+</span></summary>
          <p>{{ 'trakora.faq2_a' | t }}</p>
        </details>
        <details>
          <summary>{{ 'trakora.faq3_q' | t }}<span class="arrow">+</span></summary>
          <p>{{ 'trakora.faq3_a' | t }}</p>
        </details>
        <details>
          <summary>{{ 'trakora.faq4_q' | t }}<span class="arrow">+</span></summary>
          <p>{{ 'trakora.faq4_a' | t }}</p>
        </details>
        <details>
          <summary>{{ 'trakora.faq5_q' | t }}<span class="arrow">+</span></summary>
          <p>{{ 'trakora.faq5_a' | t }}</p>
        </details>
      </div>
    </section>
  </div>

  <!-- FINAL CTA -->
  <div class="tk-container">
    <section id="tk-buy" class="tk-final tk-reveal">
      <h2>{{ 'trakora.final_title' | t }}</h2>
      <p>{{ 'trakora.final_text' | t }}</p>
      {%- if variant -%}
        <div class="tk-price">
          <span class="now">{{ variant.price | money }}</span>
          {%- if variant.compare_at_price > variant.price -%}
            <span class="old">{{ variant.compare_at_price | money }}</span>
          {%- endif -%}
        </div>
        <br>
        <button type="submit" class="tk-cta" style="font-size:18px;padding:17px 46px;">{{ 'trakora.final_cta' | t }}</button>
      {%- else -%}
        <a href="{{ routes.all_products_collection_url }}" class="tk-cta" style="font-size:18px;padding:17px 46px;">{{ 'trakora.final_cta_fallback' | t }}</a>
      {%- endif -%}
      <div class="tk-cta-note">{{ 'trakora.guarantee_note' | t }}</div>
    </section>
  </div>

  <!-- STICKY MOBILE BUY BAR -->
  {%- if variant -%}
    <div class="tk-sticky">
      <div class="info">
        <span class="p">{{ variant.price | money }}</span>
        {%- if variant.compare_at_price > variant.price -%}<span class="o">{{ variant.compare_at_price | money }}</span>{%- endif -%}
      </div>
      <button type="submit" class="tk-cta">{{ 'trakora.final_cta' | t }}</button>
    </div>
  {%- endif -%}

  </form>

</div>

<script>
  (function () {
    var root = document.getElementById('shopify-section-{{ section.id }}');
    if (!root) return;
    var els = root.querySelectorAll('.tk-reveal');
    if (!('IntersectionObserver' in window)) { els.forEach(function (e) { e.classList.add('tk-in'); }); return; }
    var io = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) { if (en.isIntersecting) { en.target.classList.add('tk-in'); io.unobserve(en.target); } });
    }, { threshold: 0.12 });
    els.forEach(function (e) { io.observe(e); });
  })();
</script>

{% schema %}
{
  "name": "TRAKORA Landing",
  "tag": "section",
  "class": "tk-section-wrapper",
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Produkt (für Kaufen-Buttons)",
      "info": "Wähle den GPS-Tracker. Die Kaufen-Buttons legen dieses Produkt direkt in den Warenkorb."
    }
  ],
  "presets": [
    { "name": "TRAKORA Landing" }
  ]
}
{% endschema %}
